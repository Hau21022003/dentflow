# Copy this file to a root-only path outside the repository and replace the two
# credential placeholders. Never commit the populated file.
AWS_ACCESS_KEY_ID=REPLACE_SECURELY
AWS_SECRET_ACCESS_KEY=REPLACE_SECURELY
AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGION=ap-southeast-1
AWS_EC2_METADATA_DISABLED=true
BACKUP_S3_BUCKET=dentflow-staging-pg-backups
BACKUP_S3_PREFIX=postgresql/staging
