{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketMetadata",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET_NAME"
    },
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "postgresql/staging",
            "postgresql/staging/*"
          ]
        }
      }
    },
    {
      "Sid": "ListMultipartUploads",
      "Effect": "Allow",
      "Action": "s3:ListBucketMultipartUploads",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET_NAME"
    },
    {
      "Sid": "WriteEncryptedBackups",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET_NAME/postgresql/staging/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "ReadAndManageMultipartBackups",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::BACKUP_BUCKET_NAME/postgresql/staging/*"
    }
  ]
}
