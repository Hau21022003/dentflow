# Development environment. Copy this file to .env.development and replace every
# value marked "replace-with" before running the backend. Never commit .env.development.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=DentFlow
APP_SHORT_NAME=DentFlow
TIMEZONE=Asia/Ho_Chi_Minh
FALLBACK_LANG=vi

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-db-password
DB_NAME=dentflow
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Authentication and audit: generate distinct long random values for local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=7d
AUDIT_IP_HMAC_SECRET=replace-with-a-long-random-audit-ip-hmac-secret
IDEMPOTENCY_HMAC_SECRET=replace-with-a-distinct-long-random-idempotency-hmac-secret
IDEMPOTENCY_PROCESSING_LEASE=5m
IDEMPOTENCY_COMPLETED_RETENTION=30d

# Login security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_SALT_ROUNDS=12
DEFAULT_PASSWORD=replace-with-a-local-development-default-password

# Upload
UPLOAD_MAX_FILE_SIZE_MB=2

# Email: use SMTP or Amazon SES. All development delivery is redirected to
# MAIL_REDIRECT_TO. SMTP authentication is optional but needs both values.
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.test
MAIL_REDIRECT_TO=developer@example.test
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-with-smtp-user
MAIL_PASS=replace-with-smtp-password
AWS_SES_REGION=ap-southeast-1
# Leave both blank to use the AWS SDK default credential chain.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Object storage (required only when S3 storage is enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Push notifications (required only when Firebase is enabled)
FIREBASE_CREDENTIALS=
PUSH_REDIRECT_TOKENS=

# SaaS billing: select stripe or paypal and replace the matching credentials.
# This config is only for the tenant subscription to DentFlow, never clinical payments.
SAAS_BILLING_PROVIDER=stripe
SAAS_BILLING_CURRENCY=USD
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
