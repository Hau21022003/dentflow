# Browser E2E / backend test environment. Copy to .env.test and adjust local service credentials.
NODE_ENV=test
PORT=3001
APP_URL=http://127.0.0.1:3001
FRONTEND_ORIGIN=http://127.0.0.1:5174
APP_NAME=DentFlow
APP_SHORT_NAME=DentFlow
TIMEZONE=Asia/Ho_Chi_Minh
FALLBACK_LANG=vi

# Use a database dedicated to tests. Never point this file at development or production data.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dentflow_test
DB_PASSWORD=dentflow_test
DB_NAME=dentflow_test
DB_SYNCHRONIZE=false
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

JWT_ACCESS_SECRET=test-access-secret-not-for-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production
JWT_REFRESH_EXPIRES_IN=7d

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_SALT_ROUNDS=12
DEFAULT_PASSWORD=synthetic-e2e-password
UPLOAD_MAX_FILE_SIZE_MB=2

MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@dentflow.test
MAIL_REDIRECT_TO=developer@dentflow.test
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=test
MAIL_PASS=test
AWS_SES_REGION=ap-southeast-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
FIREBASE_CREDENTIALS=
PUSH_REDIRECT_TOKENS=

SAAS_BILLING_PROVIDER=paypal
SAAS_BILLING_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=test-paypal-client-id
PAYPAL_CLIENT_SECRET=test-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=test-paypal-webhook-id
