# Runtime and application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=DentFlow
APP_SHORT_NAME=DentFlow
TIMEZONE=UTC
FALLBACK_LANG=en

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
DB_NAME=dentflow
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Audit: use a distinct, long random secret to HMAC source IP addresses.
AUDIT_IP_HMAC_SECRET=replace-with-a-distinct-long-random-audit-secret

# Idempotency: use a distinct HMAC secret; these defaults are required for
# replay-safe command handling.
IDEMPOTENCY_HMAC_SECRET=replace-with-a-distinct-long-random-idempotency-hmac-secret
IDEMPOTENCY_PROCESSING_LEASE=5m
IDEMPOTENCY_COMPLETED_RETENTION=30d

# Tenant owner invitations: distinct HMAC secret, never exposed to clients.
TENANT_INVITATION_TOKEN_SECRET=replace-with-a-distinct-long-random-invitation-secret
TENANT_INVITATION_TTL=7d

# Login security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_SALT_ROUNDS=12
DEFAULT_PASSWORD=replace-with-a-non-production-seed-password

# Upload
UPLOAD_MAX_FILE_SIZE_MB=2

# Email: use SMTP or Amazon SES. MAIL_REDIRECT_TO is required in development
# and staging; production sends to the requested recipients directly.
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@example.test
MAIL_REDIRECT_TO=developer@example.test
MAIL_HOST=smtp.example.test
MAIL_PORT=587
# Optional: defaults to true when MAIL_PORT=465, otherwise false.
MAIL_SECURE=false
# SMTP authentication is optional; set both values when the server requires it.
MAIL_USER=replace-with-smtp-user
MAIL_PASS=replace-with-smtp-password
AWS_SES_REGION=ap-southeast-1
# Optional. Leave both empty to use the AWS SDK default credential chain
# (for example IAM roles, AWS_PROFILE, or environment credentials).
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Object storage (required only when S3 storage is enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Direct client image upload. Keep disabled until bucket/IAM/CORS are configured.
S3_ENABLED=false
# Optional S3-compatible endpoint, for example http://localhost:9000 for MinIO.
S3_ENDPOINT=
S3_PRESIGNED_POST_TTL=5m

# Push notifications (required only when Firebase is enabled)
FIREBASE_CREDENTIALS=
PUSH_REDIRECT_TOKENS=

# SaaS billing: choose one provider for the deployed environment.
# This config is only for the tenant's subscription to DentFlow, never clinical payments.
SAAS_BILLING_PROVIDER=stripe
SAAS_BILLING_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
